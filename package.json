{
  "name": "cred",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "test": "node --test $(find tests -maxdepth 1 -name '*.test.mjs' ! -name '*.integration.test.mjs' -print)",
    "test:integration": "node --test tests/*.integration.test.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "postbuild": "node scripts/generate-offline-sw.mjs && node scripts/verify-offline-build-output.mjs",
    "test:offline-browser": "playwright test",
    "prebuild": "node scripts/generate-apple-touch-icon.mjs && node scripts/write-offline-document.mjs && node scripts/build-offline-shell.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "idb": "^8.0.3",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@playwright/test": "^1.51.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "typescript": "latest"
  }
}
