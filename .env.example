# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the admin client for public share pages, shared printable
# reports, and the Stripe webhook. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# App origin. Used for Stripe success/cancel URLs, emailed share links, and the
# share URLs shown in the report UI. Must be an absolute URL.
NEXT_PUBLIC_APP_URL=

# OpenAI. Capture classification and evidence extraction.
OPENAI_API_KEY=

# Stripe. Subscription checkout and webhook sync.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for CRED Essentials ($39), Professional ($129), and Investigation
# ($249). The env var names keep the legacy individual/team/shop billing keys.
STRIPE_PRICE_INDIVIDUAL=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_SHOP=

# SendGrid. Printable report delivery. REPORT_EMAIL_FROM must be a verified
# sender on an authenticated sending domain.
SENDGRID_API_KEY=
REPORT_EMAIL_FROM=

# Shared secret required to run /api/internal/capture-processing/tick from Vercel Cron or scripts.
# Send as Authorization: Bearer <secret> or x-internal-secret: <secret>.
INTERNAL_CAPTURE_WORKER_SECRET=
# Backward-compatible aliases supported by the worker endpoint. CRON_SECRET is
# what Vercel Cron sends automatically.
CAPTURE_PROCESSING_INTERNAL_SECRET=
CRON_SECRET=

# Optional comma-separated organization IDs whose AI usage remains tracked
# but is not blocked by the monthly AI action limit.
AI_USAGE_BYPASS_ORGANIZATION_IDS=
